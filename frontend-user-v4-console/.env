# 打包路径 根据项目不同按需配置
VITE_BASE_URL=/
VITE_CONSOLE_ASSET_BASE_URL=/
VITE_API_BASE_URL=/api
VITE_API_URL_PREFIX=/api
VITE_APP_TITLE=创欧云
VITE_PUBLIC_SITE_URL=https://www.coyjs.cn
VITE_IS_REQUEST_PROXY=true
# 会话 Cookie 作用域：设为主域以便 console 与 www 子域共享登录态（开发环境由 .env.development 置空覆盖）
VITE_SESSION_COOKIE_DOMAIN=.coyjs.cn
