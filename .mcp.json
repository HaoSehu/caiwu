{
  "mcpServers": {
    "memory": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "time": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ]
    },
    "tdesign": {
      "toolCallTimeoutMs": 120000,
      "failOnStartupError": false,
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "tdesign-mcp-server@latest"
      ],
      "type": "stdio"
    }
  }
}
