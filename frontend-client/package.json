{
  "name": "chuangouyun-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./scripts/inject-site-verification.mjs",
    "prerender": "node ./scripts/prerender.mjs",
    "build:prerender": "npm run build && npm run prerender",
    "build:with-sitemap": "npm run build && node ./scripts/generate-sitemap.mjs",
    "generate:sitemap": "node ./scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "lint": "eslint src scripts tests --ext .js,.ts,.vue",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:source-health": "node ./scripts/check-source-health.mjs",
    "test:verification": "node ./tests/verification-client-contract.test.mjs",
    "test": "node ./tests/verification-client-contract.test.mjs && node ./tests/machineSpecOptions.test.mjs && node ./tests/ticketServiceOptionLabel.test.mjs",
    "verify:refactor": "node ./scripts/verify-refactor.mjs"
  },
  "dependencies": {
    "@caiwu/shared": "file:../shared",
    "@element-plus/icons-vue": "^2.3.0",
    "@novnc/novnc": "^1.6.0",
    "@types/three": "^0.183.1",
    "axios": "^1.7.0",
    "element-plus": "^2.9.0",
    "markdown-it": "^14.1.1",
    "pinia": "^2.2.0",
    "qrcode.vue": "^3.8.0",
    "three": "^0.183.2",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "puppeteer": "^24.41.0",
    "sass": "^1.80.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^6.0.0"
  }
}
