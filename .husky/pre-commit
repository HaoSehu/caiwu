#!/usr/bin/env sh
# 提交门禁。本文件入库（.gitignore 只忽略 husky 生成的运行时壳 .husky/_/），
# 换机器或重新 clone 后由 npm run prepare 安装 .husky/_ 的壳，pre-commit 本身随仓库分发。
#
# lint-staged 配置只在根 package.json 维护一份（已删除两端子项目配置）。
# 历史上五份配置合并曾触发 admin 的 stylelint:fix 把媒体查询改写成 Level 4 区间语法，
# 一次提交污染 44 个文件；现在冲突源已消除，无需 --config 规避。
npx lint-staged

# docs/ 的改动额外校验文档体系（docs/README.md、docs/治理/WORKING_RULES.md 已写明该行为）
if git diff --cached --name-only | grep -q '^docs/'; then
  npm run docs:check || exit 1
fi
