{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      "@caiwu/shared": ["../shared/index.ts"],
      "@caiwu/shared/*": ["../shared/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.vue",
    "scripts/**/*.mjs",
    "tests/**/*.mjs",
    "env.d.ts"
  ]
}
