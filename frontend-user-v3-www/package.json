{
  "name": "caiwu-user-v3-www",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "vite build --mode production && node ./scripts/generate-sitemap.mjs && node ./scripts/prerender-www.mjs && node ./scripts/check-budget.mjs",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "build:type": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "lint": "eslint src scripts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "npm run build:e2e && node ./scripts/e2e-run.mjs",
    "check:source-health": "node ./scripts/check-source-health.mjs",
    "verify:refactor": "node ./scripts/verify-refactor.mjs"
  },
  "dependencies": {
    "@caiwu/shared": "file:../shared",
    "pinia": "^3.0.4",
    "tdesign-icons-vue-next": "^0.4.4",
    "tdesign-vue-next": "^1.19.1",
    "vue": "^3.5.18",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.3",
    "@vitejs/plugin-vue": "^5.1.0",
    "autoprefixer": "^10",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "sass": "^1.80.0",
    "typescript": "~5.4.3",
    "typescript-eslint": "^8.29.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^6.2.2",
    "vue-tsc": "3.3.11"
  },
  "browserslist": [
    "chrome >= 84",
    "edge >= 88",
    "firefox >= 89",
    "safari >= 13.4",
    "ios_saf >= 13.4"
  ]
}
