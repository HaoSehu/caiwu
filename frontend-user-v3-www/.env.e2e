# e2e 走 preview 代理：接口请求同源，CSP 的 'self' 已覆盖。
# 但后端返回的 site_logo / site_favicon 是 http://127.0.0.1:8000/media/* 的绝对地址，
# 不经代理，由 vite.config.js 按 VITE_PREVIEW_API_TARGET 自动补进 img-src/media-src。
VITE_API_BASE_URL=/api
VITE_APP_TITLE=创欧云
VITE_PUBLIC_SITE_URL=http://127.0.0.1:4173
VITE_CONSOLE_SITE_URL=http://127.0.0.1:5173
VITE_SESSION_COOKIE_DOMAIN=
