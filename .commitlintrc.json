{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "chore",
        "ci",
        "build",
        "revert",
        "Feat",
        "Fix",
        "Docs",
        "Style",
        "Refactor",
        "Perf",
        "Test",
        "Chore"
      ]
    ],
    "type-case": [0],
    "subject-min-length": [2, "always", 2],
    "subject-max-length": [2, "always", 100]
  }
}
