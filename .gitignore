# Frontend environment files：默认整目录忽略，仅放行显式声明的模板与 e2e 公开配置。
# 改为通配后，新增 .env.staging / .env.preview 等不会再因白名单缺项而误入库。
frontend-admin-v3/.env*
frontend-user-v3-www/.env*
frontend-user-v4-console/.env*
!frontend-admin-v3/.env.example
!frontend-user-v3-www/.env.example
!frontend-user-v4-console/.env.example
# e2e 配置只含本地回环地址与空域名，不含任何凭据，需随仓库分发
!frontend-user-v3-www/.env.e2e
!frontend-user-v4-console/.env.e2e

