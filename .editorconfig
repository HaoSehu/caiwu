root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# 后端：PSR-12 要求 4 空格缩进（backend/pint.json 未覆盖 indent 规则，编辑器跟随本段）
[*.php]
indent_size = 4

# Blade 模板沿用 4 空格，与后端保持一致
[*.blade.php]
indent_size = 4
