includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:

    # B-04：paths 从只 app 扩展为 app + config + database/migrations。
    # config、database/migrations 此前被 excludePaths 显式排除，本次一并纳入并移除排除项。
    # 插件（plugins）同样纳入静态分析门禁：插件是运行时 require 加载的独立命名空间，
    # 此前只靠 audit:plugins 的注册审计，类型与调用错误无法在 CI 暴露。
    paths:
        - app
        - config
        - database/migrations
        - plugins

    # level 5：升 6 需先处理约 2989 个历史告警
    # The level 9 is the highest level
    level: 5

    excludePaths:
        - bootstrap/cache
        - storage
        - vendor
        # scripts 实测纳入后新增 35 个错误（集中在 upload_apifox_openapi.php 等一次性运维脚本，
        # 多为 nullCoalesce.offset / isset.offset 历史写法），本次不清理，保持排除。
        - scripts

    checkModelProperties: true

    ignoreErrors:
        # Add specific ignores here if needed
        # - '#some regex pattern#'

        # 迁移层的 env('FINANCE_ALLOW_RETIRE') 已改为 config('finance.retire.enabled')，
        # 原先的两条按文件忽略已删除；若再有迁移直接读 env，larastan 会重新报错。
