# 生产环境用 production；本地开发用 local 便于调试
APP_ENV=local
APP_DEBUG=true
# 必填：生产必须 php artisan key:generate 生成，否则应用无法启动
APP_KEY=

APP_URL=http://api.example.test
FRONTEND_URL=http://www.example.test
CLIENT_CONSOLE_URL=http://console.example.test
ADMIN_URL=http://admin.example.test

# ---------------------------------------------------------------------------
# 说明：本文件已按 backend/config/*.php 中 env() 实际读取逐键补全（2026-09-24
# 核对，共 155 键）。原有 17 键保持激活；其余键均以注释形式声明，取消注释并
# 填值即可覆盖 config 默认值。所有占位值均为空或 config 自带默认值，
# 不包含任何真实密钥、密码或 Token。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 应用（config/app.php、config/cors.php）
# ---------------------------------------------------------------------------
# 站点名称；同时派生默认 SESSION_COOKIE（APP_NAME 转 slug + _session）
# APP_NAME=创欧云
# 多语言与维护模式
# APP_LOCALE=zh_CN
# APP_FALLBACK_LOCALE=zh_CN
# APP_FAKER_LOCALE=en_US
# APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# 密钥轮换后的旧 APP_KEY（逗号分隔），用于解密旧数据
# APP_PREVIOUS_KEYS=

# ---------------------------------------------------------------------------
# 数据库（config/database.php）
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# URL 形式连接串（设置后优先生效，不使用请保持注释）
# DB_URL=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# DB_SOCKET=
# DB_TIMEZONE=+08:00
# mysqldump 可执行文件路径（管理端数据库备份使用）；留空按内置候选路径探测
# MYSQLDUMP_PATH=
# MySQL SSL CA 证书路径（仅 SSL 连接需要）
# MYSQL_ATTR_SSL_CA=

# ---------------------------------------------------------------------------
# Redis（config/database.php）
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
# 生产 Redis 有密码时必填
REDIS_PASSWORD=
# REDIS_CLIENT=phpredis
# REDIS_CLUSTER=redis
# REDIS_PORT=6379
# default/cache/volatile 三个连接分别使用 DB 0/1/2（volatile 为高频短 TTL 隔离库）
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_VOLATILE_DB=2
# 队列与 Redis 直接操作的前缀（缓存前缀另见 CACHE_PREFIX）
# REDIS_PREFIX=
# 是否使用持久化连接
# REDIS_PERSISTENT=false
# 连接/读超时（秒）；volatile 连接 config 默认 1/5，其余连接默认 2/10
# REDIS_TIMEOUT=2
# REDIS_READ_TIMEOUT=10

# ---------------------------------------------------------------------------
# 缓存（config/cache.php）
# ---------------------------------------------------------------------------
# 默认 redis；可选 array/file/database/redis_volatile（database 依赖 cache 表，实库未建，勿选）
# CACHE_STORE=redis
# 缓存键前缀，留空不加前缀
# CACHE_PREFIX=
# CACHE_STORE 为 redis 时的缓存连接与锁连接
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# 仅 CACHE_STORE=database 时使用（实库无 cache 表，当前不可用）
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache

# ---------------------------------------------------------------------------
# 会话（config/session.php）
# ---------------------------------------------------------------------------
# 默认 file；实库存在 sessions 表但当前未使用 database 驱动
# SESSION_DRIVER=file
# 仅 database/redis 驱动时指定独立连接
# SESSION_CONNECTION=
# 仅 redis 驱动时指定独立 store
# SESSION_STORE=
# 登录态有效期（分钟）
# SESSION_LIFETIME=120
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_ENCRYPT=false
# 默认按 APP_NAME 派生（APP_NAME slug + _session）
# SESSION_COOKIE=
# SESSION_PATH=/
# SESSION_DOMAIN=
# 生产环境默认 true，其余环境默认 false
# SESSION_SECURE_COOKIE=
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
# 仅 SESSION_DRIVER=database 时使用
# SESSION_TABLE=sessions

# ---------------------------------------------------------------------------
# 队列（config/queue.php）
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
# 失败任务重试间隔（秒）；config 默认 1500，建议保持 90 以更快重试
REDIS_QUEUE_RETRY_AFTER=90
# 业务队列与定时队列清单（queue:work 分组消费使用）
# CAIWU_BUSINESS_QUEUES=provision,referral,notification,coupon,default
# CAIWU_SCHEDULE_QUEUE=automation
# database 队列连接（留空复用默认数据库连接）
# DB_QUEUE_CONNECTION=
# DB_QUEUE=default
# DB_QUEUE_TABLE=jobs
# DB_QUEUE_FAILED_TABLE=failed_jobs
# DB_QUEUE_BATCHES_TABLE=job_batches
# redis 队列连接
# REDIS_QUEUE=default
# REDIS_QUEUE_CONNECTION=default
# 阻塞式弹出超时（秒），留空为不阻塞
# REDIS_QUEUE_BLOCK_FOR=
# QUEUE_FAILED_DRIVER=database-uuids

# ---------------------------------------------------------------------------
# 日志（config/logging.php、config/log_archive.php）
# ---------------------------------------------------------------------------
# 生产默认 daily，其余环境默认 stack
# LOG_CHANNEL=
# stack 通道的子通道清单（逗号分隔）；生产默认 daily，其余默认 single
# LOG_STACK=
# daily 通道保留天数
# LOG_DAILY_DAYS=14
# LOG_DEPRECATIONS_CHANNEL=null
# LOG_DEPRECATIONS_TRACE=false
# 日志级别；生产默认 info，其余默认 debug
# LOG_LEVEL=
# syslog facility（config 默认 LOG_USER）
# LOG_SYSLOG_FACILITY=
# API 访问日志文件保留天数（api-json 通道）
# API_LOG_DAYS=31
# 支付网关日志文件保留天数（gateway-json 通道）
# GATEWAY_LOG_DAYS=90
# 日志归档协议：v1 = pt-archiver 单阶段；v2 = 两阶段（需生产演练批准后切换）
# LOG_ARCHIVE_PROTOCOL=v1

# ---------------------------------------------------------------------------
# 令牌认证（config/sanctum.php）
# ---------------------------------------------------------------------------
# SANCTUM_TOKEN_EXPIRATION=1440
# SANCTUM_IDLE_TIMEOUT=10800
# SANCTUM_TOKEN_PREFIX=

# ---------------------------------------------------------------------------
# 文件系统（config/filesystems.php）
# ---------------------------------------------------------------------------
# FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# 邮件（config/mail.php、config/integrations.php）
# ---------------------------------------------------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# SMTP 账号与密码（启用 SMTP 发信时必填）
# MAIL_USERNAME=
# MAIL_PASSWORD=
# SMTP EHLO 域名（启用 SMTP 发信时必填）
# MAIL_EHLO_DOMAIN=
# 发件人
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME=创欧云
# 仅 MAIL_MAILER=log 时使用（记录日志的 channel）
# MAIL_LOG_CHANNEL=
# 集成层邮件驱动默认值：smtp / multi_smtp_round_robin
# MAIL_DRIVER_DEFAULT=smtp

# ---------------------------------------------------------------------------
# 集成默认驱动（config/integrations.php）
# ---------------------------------------------------------------------------
# 支付网关默认值：alipay / yipay
# PAYMENT_GATEWAY_DEFAULT=alipay
# 实名认证默认提供方：stay33
# IDENTITY_PROVIDER_DEFAULT=stay33
# 短信默认提供方：aliyun
# SMS_PROVIDER_DEFAULT=aliyun

# ---------------------------------------------------------------------------
# 支付宝（config/alipay.php；启用支付宝支付时必填前三项）
# ---------------------------------------------------------------------------
# 支付宝开放平台应用 ID
# ALIPAY_APP_ID=
# 应用私钥（PKCS1 格式，一行字符串）
# ALIPAY_PRIVATE_KEY=
# 支付宝公钥（非证书模式）
# ALIPAY_PUBLIC_KEY=
# 异步通知地址
# ALIPAY_NOTIFY_URL=
# 网关地址（沙箱: https://openapi-sandbox.dl.alipaydev.com/gateway.do）
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 是否校验上游 SSL；config 默认生产 true、local false
# ALIPAY_SSL_VERIFY=
# 自定义 CA 证书包路径
# ALIPAY_CA_BUNDLE=

# ---------------------------------------------------------------------------
# 实名认证（config/idc.php verification；启用实名时必填前两项）
# ---------------------------------------------------------------------------
# 实名认证服务地址与密钥
# VERIFICATION_API=
# VERIFICATION_KEY=
# 业务类型码
# VERIFICATION_BIZ_CODE=FACE
# 认证 API 端点
# VERIFICATION_API_ENDPOINT=https://idc.stay33.cn/realname/certapi.php
# 是否校验上游 SSL；config 默认生产 true、local false
# VERIFICATION_SSL_VERIFY=
# VERIFICATION_CA_BUNDLE=
# 单用户免费认证次数 / 失败后再认证费用（元）
# VERIFICATION_FREE_ATTEMPTS=3
# VERIFICATION_RETRY_FEE=2.00

# ---------------------------------------------------------------------------
# 短信（config/idc.php sms）
# ---------------------------------------------------------------------------
# 短信 API 端点
# SMS_API_ENDPOINT=https://dypnsapi.aliyuncs.com/
# 是否校验上游 SSL；config 默认生产 true、local false
# SMS_SSL_VERIFY=
# SMS_CA_BUNDLE=

# ---------------------------------------------------------------------------
# GeeTest 行为验证（config/idc.php geetest）
# ---------------------------------------------------------------------------
# GEETEST_ENABLED=false
# 极验验证 ID 与 Key（启用 GeeTest 时必填）
# GEETEST_CAPTCHA_ID=
# GEETEST_CAPTCHA_KEY=
# 是否校验上游 SSL；config 默认生产 true、local false
# GEETEST_SSL_VERIFY=
# GEETEST_CA_BUNDLE=

# ---------------------------------------------------------------------------
# 上游主机面板接口（config/idc.php hosting_panel_api）
# ---------------------------------------------------------------------------
# 单次上游请求总超时（秒），默认 60；上游有超长同步接口时再按环境放宽
# HOSTING_PANEL_API_TIMEOUT=60
# 上游连接超时（秒）
# HOSTING_PANEL_API_CONNECT_TIMEOUT=15
# DNS 解析超时（秒）
# HOSTING_PANEL_API_DNS_TIMEOUT=3
# 允许访问的上游主机白名单（逗号分隔；联调上游面板时必填）
# HOSTING_PANEL_API_ALLOWED_HOSTS=
# JWT 缓存使用的 store
# HOSTING_PANEL_API_JWT_CACHE_STORE=redis
# 是否校验上游 SSL；config 默认生产 true、local false
# HOSTING_PANEL_API_SSL_VERIFY=
# HOSTING_PANEL_API_CA_BUNDLE=

# ---------------------------------------------------------------------------
# VNC 中继（config/idc.php vnc_relay）
# ---------------------------------------------------------------------------
# VNC_RELAY_HOST=127.0.0.1
# VNC_RELAY_PORT=8100
# VNC_RELAY_PATH=/ws/vnc
# VNC_RELAY_CONNECT_TIMEOUT=10
# 是否校验上游 SSL；config 默认生产 true、local false
# VNC_RELAY_SSL_VERIFY=
# VNC_RELAY_CA_BUNDLE=
# 允许上游为内网地址（本地联调默认 true，生产默认 false，生产不建议开启）
# VNC_RELAY_ALLOW_PRIVATE_UPSTREAM=

# ---------------------------------------------------------------------------
# 站点与前端（config/idc.php）
# ---------------------------------------------------------------------------
# 站点名称
# IDC_SITE_NAME=创欧云
# 管理端前端构建产物路径（config 默认 ../frontend-admin-v3/dist）
# FRONTEND_DIST_PATH=

# ---------------------------------------------------------------------------
# 健康检查阈值（config/health.php）
# ---------------------------------------------------------------------------
# 调度心跳最大允许间隔（秒）
# HEALTH_SCHEDULER_MAX_AGE_SECONDS=180
# 调度任务失败统计窗口（秒）
# HEALTH_SCHEDULER_TASK_FAILURE_WINDOW_SECONDS=900
# 队列积压告警阈值（条）
# HEALTH_QUEUE_MAX_PENDING_JOBS=10000

# ---------------------------------------------------------------------------
# 领域迁移配置（config/{account,catalog,content_system,identity,service,trade}_migration.php，
# 由 app/Services/System/*MigrationService.php 消费；仅执行历史数据迁移时需要）
# ---------------------------------------------------------------------------
# ACCOUNT_MIGRATION_SOURCE_DB=mysql
# ACCOUNT_MIGRATION_TARGET_DB=mysql
# CATALOG_MIGRATION_SOURCE_DB=mysql
# CATALOG_MIGRATION_TARGET_DB=mysql
# CONTENT_SYSTEM_MIGRATION_SOURCE_DB=mysql
# CONTENT_SYSTEM_MIGRATION_TARGET_DB=mysql
# IDENTITY_MIGRATION_SOURCE_DB=mysql
# IDENTITY_MIGRATION_TARGET_DB=mysql
# SERVICE_MIGRATION_SOURCE_DB=mysql
# SERVICE_MIGRATION_TARGET_DB=mysql
# 旧库库名与表前缀（仅 service 迁移使用）
# SERVICE_MIGRATION_LEGACY_DB_DATABASE=
# SERVICE_MIGRATION_LEGACY_TABLE_PREFIX=
# TRADE_MIGRATION_SOURCE_DB=mysql
# TRADE_MIGRATION_TARGET_DB=mysql
