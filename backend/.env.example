APP_NAME="创欧云"
APP_ENV=production
# 生产环境必须为 false，否则异常堆栈会直接输出到 HTTP 响应，泄漏数据库凭证
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.com
# 官网/用户入口 (/media/*、/uploads/* 公网资源基础 URL)
FRONTEND_URL=https://your-domain.com
CLIENT_CONSOLE_URL=https://console.your-domain.com
ADMIN_URL=https://admin.your-domain.com
APP_TIMEZONE=Asia/Shanghai

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
# 生产环境必须设置强密码
DB_PASSWORD=your_password

CACHE_STORE=redis
# 队列消费并入 schedule:run，不常驻 queue:work
QUEUE_CONNECTION=database
SESSION_DRIVER=file

REDIS_HOST=127.0.0.1
# 生产环境必须设置 Redis 密码
REDIS_PASSWORD=your_redis_password
