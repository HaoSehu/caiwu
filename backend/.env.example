APP_NAME="创欧云"
# 生产环境必须改为 production
APP_ENV=production
# 生产环境必须为 false，否则异常堆栈会直接输出到 HTTP 响应，泄漏数据库凭证
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
CLIENT_CONSOLE_URL=https://console.your-domain.com
ADMIN_URL=https://admin.your-domain.com
APP_TIMEZONE=Asia/Shanghai
INSTALL_ADMIN_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
# 生产环境必须设置强密码
DB_PASSWORD=your_password
DB_TIMEZONE=+08:00

CACHE_STORE=redis
# 生产环境建议改为 redis + Supervisor 管理 queue:work
QUEUE_CONNECTION=database
# 生产环境建议改为 redis（支持水平扩展，消除文件锁）
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
# 生产环境必须设置 Redis 密码
REDIS_PASSWORD=your_redis_password

# 日志配置（生产环境使用 daily 防止单文件打满磁盘，级别建议 error）
LOG_CHANNEL=daily
LOG_LEVEL=error

# 错误监控（生产环境必须填写 Sentry DSN）
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false

ALIPAY_SSL_VERIFY=true

# Sanctum Token 过期配置（分钟）
# expiration：Token 绝对有效期，默认 1440 分钟（24小时）
# idle_timeout：空闲超时，默认 10800 秒（3小时），与 expiration 双重保护
SANCTUM_TOKEN_EXPIRATION=1440
SANCTUM_IDLE_TIMEOUT=10800
