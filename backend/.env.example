# 生产环境用 production；本地开发用 local 便于调试
APP_ENV=local
APP_DEBUG=true
# 必填：生产必须 php artisan key:generate 生成，否则应用无法启动
APP_KEY=

APP_URL=http://api.example.test
FRONTEND_URL=http://www.example.test
CLIENT_CONSOLE_URL=http://console.example.test
ADMIN_URL=http://admin.example.test

# ---------------------------------------------------------------------------
# 数据库（config/database.php）
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# 队列（config/queue.php）
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
# 失败任务重试间隔（秒）；config 默认 1500，建议保持 90 以更快重试
REDIS_QUEUE_RETRY_AFTER=90
REDIS_HOST=127.0.0.1
# 生产 Redis 有密码时必填
REDIS_PASSWORD=
