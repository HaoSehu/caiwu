APP_NAME="创欧云"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
ADMIN_URL=https://127.0.0.1:5174
APP_TIMEZONE=Asia/Shanghai

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_TIMEZONE=+08:00

CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis（缓存、分布式锁、限流均走 Redis；队列与会话按项目约定仍为 database / file）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
# 高并发场景开启持久连接减少 TCP 握手开销，phpredis 环境下生效
REDIS_PERSISTENT=false
# 连接/读取超时（秒），避免网络抖动挂起请求
REDIS_TIMEOUT=2
REDIS_READ_TIMEOUT=10

# Sanctum stateful 域名默认从 APP_URL/FRONTEND_URL/ADMIN_URL 自动解析
# 仅在需要严格收紧白名单时才显式覆盖
# SANCTUM_STATEFUL_DOMAINS=

# 黑洞查询工具上游配置
BLACKHOLE_TIMEOUT=12
BLACKHOLE_CACHE_TTL_SECONDS=60
BLACKHOLE_USER_AGENT="mozilla/5.0 (compatible; msie 5.01; windows nt 5.0)"
BLACKHOLE_NINGBO_BASE_URL=http://160.202.238.2:81
BLACKHOLE_SHIYAN_BASE_URL=http://160.202.238.2:90
BLACKHOLE_PUBLIC_BASE_URL=https://blackhole.jdidc.cn
BLACKHOLE_US1_TRAFFIC_BASE_URL=https://do.yazzi.net/index/history
BLACKHOLE_SSL_VERIFY=false
BLACKHOLE_CA_BUNDLE=
