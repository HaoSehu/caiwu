APP_ENV=production
# 生产环境必须为 false，否则异常堆栈会直接输出到 HTTP 响应，泄漏数据库凭证
APP_DEBUG=false
APP_KEY=
# 四个端必须使用独立根域名；HTTP 部署可将四项统一改为 http://。
APP_URL=https://api.your-domain.com
FRONTEND_URL=https://www.your-domain.com
CLIENT_CONSOLE_URL=https://console.your-domain.com
ADMIN_URL=https://admin.your-domain.com
# 仅当官网与控制台位于相同主域时设置；本地开发留空。
CLIENT_SESSION_COOKIE_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
# 生产环境必须设置强密码
DB_PASSWORD=your_password

REDIS_HOST=127.0.0.1
# 生产环境必须设置 Redis 密码
REDIS_PASSWORD=your_redis_password
