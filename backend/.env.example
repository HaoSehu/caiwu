APP_NAME="创欧云"
APP_ENV=production
# 生产环境必须为 false，否则异常堆栈会直接输出到 HTTP 响应，泄漏数据库凭证
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.com
# 统一站点：官网在 /，用户控制台在 /client，管理端在 /admin。
# /media/* 与 /uploads/* 公网资源基础 URL 也走此域名。
FRONTEND_URL=https://your-domain.com
CLIENT_CONSOLE_URL=https://your-domain.com
ADMIN_URL=https://your-domain.com/admin
APP_TIMEZONE=Asia/Shanghai

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
# 生产环境必须设置强密码
DB_PASSWORD=your_password

# 日志归档（Linux 生产环境需安装 Percona Toolkit）
LOG_ARCHIVE_ROOT=/www/wwwroot/caiwu/backend/storage/app/private/log-archives
LOG_ARCHIVE_REPORT_ROOT=/www/wwwroot/caiwu/backend/storage/logs/log-archive
# 使用 NAS 时填写挂载点；本地磁盘留空
LOG_ARCHIVE_MOUNT_POINT=
LOG_ARCHIVE_CONCURRENCY=2
LOG_ARCHIVE_BATCH_SIZE=1000
LOG_ARCHIVE_SLEEP_SECONDS=1
PT_ARCHIVER_BINARY=/usr/bin/pt-archiver
PT_ARCHIVER_DEFAULTS_FILE=/etc/caiwu/pt-archiver.cnf

CACHE_STORE=redis
# 队列消费并入 schedule:run，不常驻 queue:work
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3900
CAIWU_WORKER_TIMEOUT=1200
CAIWU_WORKER_MAX_TIMEOUT=3600
CAIWU_WORKER_DRAIN_LOCK_TTL=3960
SESSION_DRIVER=file

REDIS_HOST=127.0.0.1
# 生产环境必须设置 Redis 密码
REDIS_PASSWORD=your_redis_password
