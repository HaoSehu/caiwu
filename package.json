{
  "name": "caiwu-frontends-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend-admin-v3",
    "frontend-user-v3-www",
    "frontend-user-v4-console",
    "shared"
  ],
  "scripts": {
    "dev:admin-v3": "npm run dev --workspace chuangouyun-admin-v3",
    "dev:user-v3-www": "npm run dev --workspace chuangouyun-user-v3-www",
    "dev:user-v4-console": "npm run dev --workspace chuangouyun-user-v4-console",
    "build:admin-v3": "npm run build --workspace chuangouyun-admin-v3",
    "build:user-v3-www": "npm run build --workspace chuangouyun-user-v3-www",
    "build:user-v4-console": "npm run build --workspace chuangouyun-user-v4-console",
    "build:frontends": "npm run build:admin-v3 && npm run build:user-v3-www && npm run build:user-v4-console",
    "lint:shared": "npm run lint --workspace shared",
    "lint:admin-v3": "npm run lint --workspace chuangouyun-admin-v3",
    "lint:user-v3-www": "npm run lint --workspace chuangouyun-user-v3-www",
    "lint:user-v4-console": "npm run lint --workspace chuangouyun-user-v4-console",
    "lint:frontends": "npm run lint:shared && npm run lint:admin-v3 && npm run lint:user-v3-www && npm run lint:user-v4-console",
    "typecheck:shared": "npm run typecheck --workspace shared",
    "typecheck:admin-v3": "npm run typecheck --workspace chuangouyun-admin-v3",
    "typecheck:user-v3-www": "npm run build:type --workspace chuangouyun-user-v3-www",
    "typecheck:user-v4-console": "npm run build:type --workspace chuangouyun-user-v4-console",
    "typecheck:frontends": "npm run typecheck:shared && npm run typecheck:admin-v3 && npm run typecheck:user-v3-www && npm run typecheck:user-v4-console",
    "test:shared": "npm run test --workspace shared",
    "test:admin-v3": "npm run test --workspace chuangouyun-admin-v3",
    "test:user-v3-www": "npm run test --workspace chuangouyun-user-v3-www",
    "test:user-v4-console": "npm run test --workspace chuangouyun-user-v4-console",
    "test:frontends": "npm run test:shared && npm run test:admin-v3 && npm run test:user-v3-www && npm run test:user-v4-console",
    "format": "prettier --write \"**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,json,css,scss,md}\"",
    "verify:frontends": "npm run lint:frontends && npm run typecheck:frontends && npm run test:frontends && npm run build:frontends && npm run verify:refactor --workspace chuangouyun-user-v3-www && npm run verify:refactor --workspace chuangouyun-user-v4-console",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.25.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.3",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.10"
  }
}
