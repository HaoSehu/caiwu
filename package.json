{
  "name": "caiwu-frontends-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend-admin-v3",
    "frontend-user-v3-www",
    "frontend-user-v4-console",
    "shared"
  ],
  "scripts": {
    "dev:admin-v3": "npm run dev --workspace caiwu-admin-v3",
    "dev:user-v3-www": "npm run dev --workspace caiwu-user-v3-www",
    "dev:user-v4-console": "npm run dev --workspace caiwu-user-v4-console",
    "build:admin-v3": "node backend/scripts/build_frontends.mjs --target=admin",
    "build:user-v3-www": "node backend/scripts/build_frontends.mjs --target=www",
    "build:user-v4-console": "node backend/scripts/build_frontends.mjs --target=console",
    "build:frontends": "node backend/scripts/build_frontends.mjs",
    "build:frontends:dry": "node backend/scripts/build_frontends.mjs --dry-run",
    "test:build-config": "node backend/scripts/build_frontends.test.mjs",
    "docs:check": "node backend/scripts/check_docs.mjs",
    "docs:freshness": "node backend/scripts/check_docs.mjs --freshness",
    "lint:shared": "npm run lint --workspace shared",
    "lint:admin-v3": "npm run lint --workspace caiwu-admin-v3",
    "lint:user-v3-www": "npm run lint --workspace caiwu-user-v3-www",
    "lint:user-v4-console": "npm run lint --workspace caiwu-user-v4-console",
    "lint:frontends": "npm run lint:shared && npm run lint:admin-v3 && npm run lint:user-v3-www && npm run lint:user-v4-console",
    "typecheck:shared": "npm run typecheck --workspace shared",
    "typecheck:admin-v3": "npm run build:type --workspace caiwu-admin-v3",
    "typecheck:user-v3-www": "npm run build:type --workspace caiwu-user-v3-www",
    "typecheck:user-v4-console": "npm run build:type --workspace caiwu-user-v4-console",
    "typecheck:frontends": "npm run typecheck:shared && npm run typecheck:admin-v3 && npm run typecheck:user-v3-www && npm run typecheck:user-v4-console",
    "test:shared": "npm run test --workspace shared",
    "format": "prettier --write \"**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,json,css,scss,md}\"",
    "verify:frontends": "npm run lint:frontends && npm run typecheck:frontends && npm run build:frontends && npm run verify:refactor --workspace caiwu-user-v3-www && npm run verify:refactor --workspace caiwu-user-v4-console",
    "workspace:health": "node backend/scripts/workspace_health_check.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend-admin-v3/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix --no-warn-ignored --config frontend-admin-v3/eslint.config.js",
      "prettier --write"
    ],
    "frontend-user-v3-www/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix --no-warn-ignored --config frontend-user-v3-www/eslint.config.js",
      "prettier --write"
    ],
    "frontend-user-v4-console/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix --no-warn-ignored --config frontend-user-v4-console/eslint.config.js",
      "prettier --write"
    ],
    "shared/**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix --no-warn-ignored --config shared/eslint.config.js",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ],
    "backend/**/*.php": [
      "php backend/vendor/bin/pint --test"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.25.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.3",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.10"
  },
  "dependencies": {
    "sharp": "^0.35.1"
  },
  "overrides": {
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "tvision-color@1.6.0": {
      "@babel/runtime-corejs3": "7.29.7"
    },
    "brace-expansion": "1.1.18",
    "postcss": "8.5.26",
    "nanoid@<4": "3.3.18",
    "undici": "7.29.0",
    "fast-uri@<4": "3.1.5",
    "less@<4.9.0": "4.9.0"
  }
}
